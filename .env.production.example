# VoyageLuxe - Production Environment Configuration

# Application
APP_NAME="VoyageLuxe"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://voyageluxe.tn

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voyageluxe_production
DB_USERNAME=voyageluxe_user
DB_PASSWORD=STRONG_PASSWORD_HERE

# Cache & Session  
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=contact@voyageluxe.tn
MAIL_PASSWORD=YOUR_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@voyageluxe.tn"
MAIL_FROM_NAME="VoyageLuxe"

# Stripe
STRIPE_KEY=pk_live_YOUR_STRIPE_PUBLIC_KEY
STRIPE_SECRET=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# PayPal
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_SECRET=YOUR_PAYPAL_SECRET
PAYPAL_CURRENCY=TND

# Flouci (Mobile Money Tunisia)
FLOUCI_APP_TOKEN=YOUR_FLOUCI_APP_TOKEN
FLOUCI_APP_SECRET=YOUR_FLOUCI_APP_SECRET

# AWS S3
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=voyageluxe-uploads

# Tawk.to
TAWKTO_PROPERTY_ID=YOUR_PROPERTY_ID
TAWKTO_WIDGET_ID=YOUR_WIDGET_ID

# Google
GOOGLE_ANALYTICS_ID=G-YOUR_GA_ID
GOOGLE_MAPS_API_KEY=YOUR_MAPS_KEY

# WhatsApp
WHATSAPP_NUMBER=21612345678

# Trust Stats
TRUST_YEARS_EXPERIENCE=15
TRUST_TOTAL_CLIENTS=50000
TRUST_GOOGLE_RATING=4.8
